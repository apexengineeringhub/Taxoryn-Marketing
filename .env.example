# ==========================================
# Taxoryn Environment Configuration
# ==========================================

# Main Taxoryn Web Application URL
# (Supported aliases: NEXT_PUBLIC_WEB_APP_URL, NEXT_PUBLIC_APP_URL, VITE_WEB_APP_URL)
NEXT_PUBLIC_APP_URL=https://app.taxoryn.com
NEXT_PUBLIC_WEB_APP_URL=https://app.taxoryn.com

# Android Application Release Configuration
# Direct APK download URL (Leave empty or '#' to gracefully disable direct download)
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=
# Current Android App release version (e.g. 1.0.0)
NEXT_PUBLIC_ANDROID_APP_VERSION=1.0.0
# Whether Android download is enabled on the marketing site (true/false)
NEXT_PUBLIC_ANDROID_DOWNLOAD_ENABLED=true

# Early Access & Contact Configuration
NEXT_PUBLIC_EARLY_ACCESS_ENABLED=true
NEXT_PUBLIC_CONTACT_EMAIL=support@taxoryn.com

# Taxoryn YouTube Product Demo Video ID
NEXT_PUBLIC_TAXORYN_DEMO_YOUTUBE_ID=Kx-DqKwOlqM

# Social Media Configuration (Official Taxoryn channels)
NEXT_PUBLIC_TAXORYN_YOUTUBE_URL=https://www.youtube.com/@taxoryn
NEXT_PUBLIC_TAXORYN_LINKEDIN_URL=https://www.linkedin.com/company/taxoryn
NEXT_PUBLIC_TAXORYN_INSTAGRAM_URL=
NEXT_PUBLIC_TAXORYN_FACEBOOK_URL=
NEXT_PUBLIC_TAXORYN_YOUTUBE_ENABLED=true
NEXT_PUBLIC_TAXORYN_LINKEDIN_ENABLED=true
NEXT_PUBLIC_TAXORYN_INSTAGRAM_ENABLED=false
NEXT_PUBLIC_TAXORYN_FACEBOOK_ENABLED=false

# Analytics Configuration
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=custom
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Cloudflare Pages / Serverless Function Email Config (Optional)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Taxoryn <notifications@taxoryn.com>
# TAXORYN_NOTIFICATION_EMAIL=support@taxoryn.com
