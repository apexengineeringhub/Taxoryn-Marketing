# Taxoryn Marketing Environment Configuration Example
# Public environment variables (safe to expose on frontend)

# Analytics Configuration
# NEXT_PUBLIC_ANALYTICS_ENABLED: Set to 'true' to enable analytics measurement (disabled by default)
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# NEXT_PUBLIC_ANALYTICS_PROVIDER: Analytics provider ('custom', 'plausible', 'google-analytics', 'none')
NEXT_PUBLIC_ANALYTICS_PROVIDER=custom

# NEXT_PUBLIC_ANALYTICS_DEBUG: Set to 'true' to output sanitized event payloads to the browser console during development
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# NEXT_PUBLIC_ANALYTICS_ID: Optional measurement ID (e.g., GA4 ID 'G-XXXXXXXXXX' or Plausible Domain)
# NEXT_PUBLIC_ANALYTICS_ID=
