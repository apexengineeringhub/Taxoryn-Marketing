# ==========================================
# Taxoryn Marketing Website - Environment Variables
# ==========================================

# YouTube Product Demo Video ID (11-character string, e.g. dQw4w9WgXcQ)
NEXT_PUBLIC_TAXORYN_DEMO_YOUTUBE_ID=

# Main Taxoryn App URL for Login / Authentication redirects
NEXT_PUBLIC_APP_URL=https://app.taxoryn.com

# Analytics Configuration (Optional)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=custom
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_ANALYTICS_ID=
